# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/animal-rescue?retryWrites=true&w=majority

# Session Encryption Secret
SESSION_SECRET=your_super_secret_session_key_here

# Secret Verification Code for Admin Login
ADMIN_SECRET_CODE=RESCUE_ADMIN_2026

# Server Port (Local)
PORT=3000

# Set to true for local HTTP testing (disables secure cookie flag)
IS_LOCAL=true
