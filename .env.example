# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/animal-rescue?retryWrites=true&w=majority

# Session Secret (Random string for signing cookies)
SESSION_SECRET=your_super_secret_session_key_here

# Local Development Port
PORT=3000

# Secret Code required for Admin accounts
ADMIN_SECRET_CODE=your_admin_secret_code_here

# Environment
NODE_ENV=production
